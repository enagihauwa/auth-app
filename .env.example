# Node server
# Where the API listens. Default: 3000
PORT=3000
# production | development. Makes the session cookie Secure-only when production.
NODE_ENV=development

# PostgreSQL connection string.
# Comes from the database you create in step 3 of How To Run It.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE

# Session signing secret. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# Base URL of the frontend, used to build links inside emails.
APP_URL=http://localhost:5173

# Outbound email via SMTP. In development this is Mailpit (http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Leave SMTP_USER / SMTP_PASS empty when the local SMTP server needs no auth.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Auth App <auth@localhost>

# Timing knobs, all in milliseconds.
VERIFICATION_CODE_TTL_MS=900000
RESET_TOKEN_TTL_MS=1800000
RESEND_COOLDOWN_MS=60000

# ---- AI receipt processing (Assessment 3 slice) ----
# Gemini API key, free from Google AI Studio. Paste your real key into .env by hand.
# Get one at https://aistudio.google.com/apikey — the app still runs and reports
# "not configured" on every job until you do.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Every changeable behaviour of the AI slice lives below (defaults match config.js
# in case any of these lines are removed).
PROCESSING_MODEL_ID=gemini-3.6-flash
PROCESSING_MODEL_TIMEOUT_MS=45000
PROCESSING_CONCURRENCY=2
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BACKOFF_MS=1500
PROCESSING_MAX_FILES=6
PROCESSING_MAX_FILE_BYTES=5242880
PROCESSING_ALLOWED_MIMES=image/jpeg,image/png,image/webp,application/pdf
PROCESSING_UPLOAD_LIMIT=10
PROCESSING_FOLLOWUP_LIMIT=20
PROCESSING_RETRY_LIMIT=5