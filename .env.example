# Node server
# Where the API listens. Default: 3000
PORT=3000
# production | development. Makes the session cookie Secure-only when production.
NODE_ENV=development

# PostgreSQL connection string.
# Comes from the database you create in step 3 of How To Run It.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE

# Session signing secret. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# Base URL of the frontend, used to build links inside emails.
APP_URL=http://localhost:5173

# Base URL of this server, used to build the hosted checkout links the mock
# provider serves. Must be reachable by the payer.
SERVER_URL=http://localhost:3000

# Billing
# Secret that signs the mock provider's webhooks. Generate one like SESSION_SECRET.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME
# How long an opened checkout stays payable before it expires (ms). Default 30 min.
CHECKOUT_TTL_MS=1800000

# Outbound email via SMTP. In development this is Mailpit (http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Leave SMTP_USER / SMTP_PASS empty when the local SMTP server needs no auth.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Auth App <auth@localhost>

# Timing knobs, all in milliseconds.
VERIFICATION_CODE_TTL_MS=900000
RESET_TOKEN_TTL_MS=1800000
RESEND_COOLDOWN_MS=60000

# Rate limiting. Values below are the safe defaults for a single-node dev box;
# raise the signin budget (or set TRUST_PROXY correctly) before traffic runs
# through a shared network / reverse proxy.
# Number of proxy hops in front of this server. 0 (default) when reachable
# directly, so spoofed X-Forwarded-For headers are ignored.
TRUST_PROXY=0
# Sign-in: per-account budget in a window, and a broader per-IP safety net.
SIGNIN_WINDOW_MINUTES=15
SIGNIN_PER_ACCOUNT=20
SIGNIN_PER_IP=60
# Sign-up: one hub bucket per IP per window.
SIGNUP_WINDOW_MINUTES=60
SIGNUP_PER_IP=5
# Forgot/resend: per-account (ip+email) budgets.
FORGOT_WINDOW_MINUTES=60
FORGOT_PER_ACCOUNT=5
RESEND_WINDOW_MINUTES=60
RESEND_PER_ACCOUNT=5
# Blunt global cap over everything except the excluded read-only endpoints.
GENERIC_WINDOW_MINUTES=60
GENERIC_MAX=180